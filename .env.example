# کلید رمزنگاری — در production حتماً یک مقدار تصادفی قوی وارد کنید
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# ── دیتابیس ──
# برای PostgreSQL (توصیه‌شده برای محیط production):
DATABASE_URL=postgresql://user:password@localhost:5432/coop_db

# برای SQLite (فقط محیط توسعه محلی):
# DATABASE_URL=sqlite:///noyan.db

# ── حساب ادمین (خوانده‌شده توسط seed_default.sh) ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_FIRST_NAME=مدیر
ADMIN_LAST_NAME=سامانه

# ── تنظیمات سایت (خوانده‌شده توسط seed_default.sh) ──
SITE_TITLE=هیئت امنای مسکن دادگستری زنجان
SITE_SUBTITLE=سامانه آنلاین مدیریت دفترچه مالکیت
SITE_PHONE=
SITE_ADDRESS=
EXEC_MANAGER=علی غفاری
BOARD_REP=خلیل باقری
BOARD_TITLE=هیئت رئیسه امنای مسکن دادگستری استان زنجان

# ── ربات بله ──
# توکن ربات از BotFather بله بگیرید
# جایگزین تنظیم از پنل ادمین (env var اولویت دارد)
BALE_TOKEN=your-bale-bot-token-here

# ── پنل پیامکی sms.ir ──
# جایگزین تنظیم از پنل ادمین (env var اولویت دارد)
# SMSIR_API_KEY=your-smsir-api-key
# SMSIR_TEMPLATE_ID=123456   # شناسه قالب «ارسال سریع» با پارامتر CODE
# SMSIR_LINE_NUMBER=30007732 # شماره خط برای پیامک عادی (اختیاری)

# ── Production (پشت nginx) ──
# با FLASK_DEBUG هرگز در production اجرا نکنید — این‌جا ست نشود.
# FLASK_DEBUG=1                     # فقط توسعه محلی
BEHIND_PROXY=1                      # اعتماد به هدرهای X-Forwarded-* از nginx
SESSION_COOKIE_SECURE=1            # فقط وقتی HTTPS فعال است
BIND=127.0.0.1:8000               # آدرس bind گونیکورن
WEB_CONCURRENCY=3                  # تعداد worker گونیکورن

# ── امنیت ──
# ذخیره‌ساز rate limit — برای deploy چند-worker از Redis استفاده کنید
# RATELIMIT_STORAGE_URI=redis://localhost:6379

# رمز عبور پیش‌فرض برای مالکان جدید ایجادشده از طریق انتقال دفترچه
# کاربر باید پس از ورود اول رمز را تغییر دهد
DEFAULT_NEW_OWNER_PASSWORD=changeme123
